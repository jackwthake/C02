reg u8 PORTB @ 0x6000;
reg u8 PORTA @ 0x6001;
reg u8 DDRB @ 0x6002;
reg u8 DDRA @ 0x6003;

// PORTB = LCD data lines
// PORTA = top 3 bits for control lines, PA7 = enable, PA6 = read/write, PA6 = register select

fn lcd_send_command(u8 cmd) -> void {
  PORTB = cmd; // Put command on data lines
  PORTA = 0x80; // RS=0, E=1 to latch command
  PORTA = 0x00; // E=0 to complete command
}

fn lcd_init() -> void {
  // Set the data direction registers for PORTA and PORTB to output
  DDRB = 0xFF; // Set all pins of PORTB as output
  DDRA = 0xE0; // Set top 3 bits of PORTA as output (for RS, RW, E)
  
  // Clear the ports to start with a known state
  PORTB = 0; // Clear PORTB
  PORTA = 0; // Clear PORTA

  // Initialize the LCD (following a typical initialization sequence)
  lcd_send_command(0x38); // Function set: 8-bit, 2 lines, 5x8 dots
  lcd_send_command(0x0C); // Display on, cursor off
  lcd_send_command(0x06); // Entry mode set: increment cursor, no shift
}

fn lcd_putc(u8 ch) -> void {
  PORTB = ch; // Put character on data lines
  PORTA = 0x32; // RS
  PORTA = 0xA0; // RS | E
  PORTA = 0x32; // RS
}

// test cases:
// global and local no padding chars:    Success - full program runs
// global no local no padding chars:     Success - full program runs
// local no global no padding chars:     Success - full program runs
// no local no global no padding chars:  Fails - Lcd inits properly but freezes with 'H' on the screen, and 72 (H) on PortB
// global and local w/ padding chars:    Success - full program runs
// global no local w/ padding chars:     Success - full program runs
// local no global w/ padding chars:     Success - full program runs
// no local no global  w/ padding chars: Fails - Lcd inits properly but freezes with nothing on the screen, and 32 (space) on PortB

// My best guess is something latent to do with the stack in page 1 getting corrupted
// what if the args are overflowing the argument section of zeropage?
// can't be a timing issue Im running the clock at 1khz far too slow for those issues

u8 space = 32;
fn main() -> void {
  // u8 l = 108;
  lcd_init();

  lcd_putc(32);   //
  lcd_putc(32);   // 
  lcd_putc(32);   // 

  lcd_putc(72);   // H
  lcd_putc(101);  // e
  lcd_putc(108);  // l
  lcd_putc(108);  // l
  lcd_putc(111);  // o
  lcd_putc(32);   // 
  lcd_putc(67);   // C
  lcd_putc(48);   // 0
  lcd_putc(50);   // 2
  lcd_putc(33);   // !
}
