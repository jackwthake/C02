reg u8 PORTB @ 0x6000;
reg u8 PORTA @ 0x6001;
reg u8 DDRB @ 0x6002;
reg u8 DDRA @ 0x6003;

/*
 PORTB = LCD data lines
 PORTA = top 3 bits for control lines, PA7 = enable, PA6 = read/write, PA6 = register select
*/

u8 *msg = "Hello C02!";

struct string {
  u8 *val;
  u8 length;
}

fn main() -> void {
  // Set the data direction registers for PORTA and PORTB to output
  DDRB = 0xFF; // Set all pins of PORTB as output
  DDRA = 0xE0; // Set top 3 bits of PORTA as output (for RS, RW, E)
  
  // Clear the ports to start with a known state
  PORTB = 0; // Clear PORTB
  PORTA = 0; // Clear PORTA

  // Initialize the LCD (following a typical initialization sequence)
  PORTB = 0x38; // Put command on data lines
  PORTA = 0x80; // RS=0, E=1 to latch command
  PORTA = 0x00;

  PORTB = 0x0C; // Put command on data lines
  PORTA = 0x80; // RS=0, E=1 to latch command
  PORTA = 0x00;

  PORTB = 0x06; // Put command on data lines
  PORTA = 0x80; // RS=0, E=1 to latch command
  PORTA = 0x00;

  string str = string { .length = 10, .val = msg };

  for (u8 i = 0; i < str.length; ++i) {
    PORTB = *(str.val + i); // Put character on data lines
    PORTA = 0x32; // RS
    PORTA = 0xA0; // RS | E
    PORTA = 0x32; // RS
  }
}
