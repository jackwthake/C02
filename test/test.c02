reg u8 PORTA @ 0x6001;
reg u8 PORTB @ 0x6000;

u16 monitor_addr = 0x8000;

fn scroll_up() -> void {
  monitor_addr += 8;
}

fn scroll_down() -> void {
  monitor_addr -= 8;
}

fn read_byte(u16 addr) -> u8 {
  u8* ptr = addr;
  return *ptr;
}

fn main() -> void {
  u8 x = 0;

  while(monitor_addr) {
    x = read_byte(monitor_addr);
  }

  if (test_condition == 1) {
    i16 y = x * x;
    u8 z = 16 * 2;
    i8 w = 16 * 2;
  } else {
    x = 10;
  }
}