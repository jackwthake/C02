u8 global = 10;
i8 signed_global = 8 * 9 / 6;
u16 casted = (u16)signed_global;
i16 grouped = (10 + 59) * (42 * 10);

u8 *string = "hello world";
u16 *global_ptr = &casted;
u16 **double_ptr = &global_ptr;   // multi-level pointer: prints as u16** not u16*
i16 *signed_global_ptr;
void *void_ptr;

u16 dereffed = *global_ptr;

fn main () -> void { }