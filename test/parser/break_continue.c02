// break_continue.c02
// break and continue statements (SPEC) in while and for bodies, including
// inside nested loops and guarded by conditionals. They are bare statements
// terminated by ';'.

fn main() -> void {
  u8 x = 0;

  while (x < 100) {
    if (x == 50) {
      break;
    }
    if (x == 10) {
      x = x + 5;
      continue;
    }
    x = x + 1;
  }

  for (u8 i = 0; i < 10; i = i + 1) {
    if (i == 3) {
      continue;
    }
    if (i == 8) {
      break;
    }
  }

  // nested loops each with their own break/continue
  for (u8 a = 0; a < 4; a = a + 1) {
    while (x > 0) {
      if (x == 1) {
        break;
      }
      x = x - 1;
      continue;
    }
  }

  return;
}
