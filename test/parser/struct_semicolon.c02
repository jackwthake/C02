// Regression: a struct declaration may be followed by an optional ';'.
// The README documents structs as `struct Foo { ... };`, but the existing
// corpus omits the semicolon - both forms must parse, at top level and inside
// a block. (Before the fix, a top-level `struct {...};` failed to parse.)

struct WithSemi {
  u8 a;
  u16 b;
};

struct WithoutSemi {
  u8 c;
}

fn main() -> void {
  // a struct decl with a trailing ';' inside a block parses too
  struct LocalSemi {
    u8 d;
  };

  WithSemi w;
  w.a = 1;
  w.b = 2;
}
