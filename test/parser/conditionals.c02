// parser_conditionals.c02
// Exercises if / else if / else chains, while, and for at every shape:
// no-else, single-else, multi-level else-if, nested ifs, empty bodies,
// and the dangling-else case where else binds to the nearest open if.

fn main() -> void {
  u8 x = 10;

  // plain if, no else
  if (x > 0) {
    x = x - 1;
  }

  // if / else
  if (x > 0) {
    x = x - 1;
  } else {
    x = 0;
  }

  // if / else if / else (3-way chain)
  if (x == 0) {
    x = 1;
  } else if (x == 1) {
    x = 2;
  } else {
    x = 3;
  }

  // longer else-if chain
  if (x == 0) {
    x = 10;
  } else if (x == 1) {
    x = 11;
  } else if (x == 2) {
    x = 12;
  } else if (x == 3) {
    x = 13;
  } else {
    x = 99;
  }

  // else-if chain with no terminal else
  if (x == 0) {
    x = 10;
  } else if (x == 1) {
    x = 11;
  } else if (x == 2) {
    x = 12;
  }

  // nested if inside then-block
  if (x > 0) {
    if (x > 5) {
      x = 100;
    } else {
      x = 50;
    }
  }

  // dangling else: outer if has closed block, else binds to inner if
  // (regression case from earlier debugging session)
  if (x > 0) {
    while (x > 5) {
      x = x - 1;
    }
  } else if (x == 0) {
    x = 1;
  } else {
    if (x < 0) {
      x = 0;
    } else if (x == 1) {
      x = 2;
    } else {
      x = 3;
    }
  }

  // while: basic
  while (x > 0) {
    x = x - 1;
  }

  // while: empty body
  while (x != 0);

  // while: condition with bitwise/comparison mix
  while ((x & 1) == 0) {
    x = x + 1;
  }

  // for: full form
  for (u8 i = 0; i < 10; i = i + 1) {
    x = x + i;
  }

  // for: empty init
  u8 j = 0;
  for (; j < 10; j = j + 1) {
    x = x + j;
  }

  // for: empty cond
  for (u8 k = 0; ; k = k + 1) {
    if (k > 10) {
      return;
    }
  }

  // for: empty increment
  for (u8 m = 0; m < 10;) {
    x = x + m;
    m = m + 1;
  }

  // for: fully empty clauses
  for (;;) {
    if (x > 1000) {
      return;
    }
    x = x + 1;
  }

  // for: empty body
  for (u8 n = 0; n < 10; n = n + 1);

  // for containing if/else-if/else inside its body
  for (u8 p = 0; p < 5; p = p + 1) {
    if (p == 0) {
      x = 0;
    } else if (p == 1) {
      x = 1;
    } else {
      x = 2;
    }
  }

  // while containing nested if/else-if/else and a for loop
  while (x < 50) {
    if (x < 10) {
      x = x + 5;
    } else if (x < 30) {
      for (u8 q = 0; q < 3; q = q + 1) {
        x = x + q;
      }
    } else {
      x = x + 1;
    }
  }

  return;
}