// DESC: && short-circuits: with a == 0 the RHS call set_flag() must NOT run, so
// flag stays 0. main then writes flag+200 as a sentinel proving it ran to the
// end — 200 means skipped-correctly, 201 means the RHS wrongly executed.
// Exercises the frontend's short-circuit lowering (&& -> chained branches).
// EXPECT: mem8[0x6000] == 200
reg u8 PORTB @ 0x6000;
u8 flag = 0;

fn set_flag() -> u8 {
  flag = 1;
  return 1;
}

fn main() -> void {
  u8 a = 0;
  if (a && set_flag()) {
    flag = 99;
  }
  PORTB = flag + 200;
}
