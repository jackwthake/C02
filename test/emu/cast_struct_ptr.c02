// DESC: cast a constant address to Point* and write fields through it
// (memory-mapped-struct idiom): (Point*)0x1000 -> mem[0x1000]=55, mem[0x1001]=22.
// Exercises TAC_CAST with an OPERAND_CONST_INT source, not just a variable.
// EXPECT: mem8[0x1000] == 55
// EXPECT: mem8[0x1001] == 22
// EXPECT: mem8[0x6000] == 22
reg u8 PORTB @ 0x6000;

struct Point {
  u8 x;
  u8 y;
}

fn main() -> void {
  Point *q = (Point*)0x1000;
  q.x = 55;
  q.y = 22;
  PORTB = q.y;
}
