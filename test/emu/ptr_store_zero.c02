// DESC: *p = 0 stores one byte; the literal 0 (void*, S-3.4) is narrowed to the
// pointee u8 so the store does not clobber the byte above (Deref store path).
// EXPECT: mem8[0x6000] == 0
// EXPECT: mem8[0x6001] == 0xAB
reg u8 PORTA @ 0x6001;

fn main() -> void {
  u8 *p = (u8*)0x6000;
  PORTA = 0xAB;   // sentinel one byte above *p
  *p = 0;         // pre-fix: stored 2 bytes and wiped PORTA
}
