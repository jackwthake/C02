// DESC: || short-circuits: with a == 1 the RHS call set_flag() must NOT run, so
// flag stays 0. main writes flag+200 as a run-to-end sentinel: 200 = skipped
// correctly, 201 = RHS wrongly executed.
// EXPECT: mem8[0x6000] == 200
reg u8 PORTB @ 0x6000;
u8 flag = 0;

fn set_flag() -> u8 {
  flag = 1;
  return 1;
}

fn main() -> void {
  u8 a = 1;
  if (a || set_flag()) {
    PORTB = flag + 200;
  }
}
