// DESC: eight-parameter call at the ABI_MAX_PARAMS boundary; sum 1..8 == 36
// EXPECT: mem8[0x6000] == 36
reg u8 PORTB @ 0x6000;

fn sum8(u8 a, u8 b, u8 c, u8 d, u8 e, u8 f, u8 g, u8 h) -> u8 {
  return a + b + c + d + e + f + g + h;
}

fn main() -> void {
  PORTB = sum8(1, 2, 3, 4, 5, 6, 7, 8);
}
