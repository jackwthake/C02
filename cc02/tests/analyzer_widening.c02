// Exercises type widening and null compatibility

struct Pair {
  u8 a;
  u16 b;
}

fn takes_u16(u16 x) -> void {
  return;
}

fn main() -> void {
  // u8 widens into u16
  u8 small = 5;
  u16 big = small;

  // u8 literal into u16 var
  u16 also_big = 10;

  // u8 arg into u16 param
  takes_u16(small);

  // comparison between u8 and u16 widens to u16
  u16 cmp = small > also_big;

  // null is compatible with any pointer
  u8 *p = null;
  u16 *q = null;

  // null in comparison with pointer
  if (p == null) {
    u8 x = 0;
  }

  // 0 works as an integer too
  u8 zero = 0;
  u16 also_zero = 0;

  // arithmetic with mixed widths
  u16 sum = small + also_big;
}
