reg u8 PORTB @ 0x6000;

u16 global_symbol;

struct test_struct {
  u16 x;
  i8 y;
}

test_struct global_instance;   // struct-typed global (resolves to test_struct)


fn sum(u8 a, u8 b) -> u8 {
  return a + b;
}

fn main() -> void {
  u8 x = 20;
  u8 y = 10;

  u8 res = sum(x, y);
  test_struct tester = test_struct { .x = res, .y = y };
}