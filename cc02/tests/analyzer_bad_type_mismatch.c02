// Exercises type mismatch errors: narrowing, pointer/int mismatch,
// wrong return type, wrong arg type

fn takes_u8(u8 x) -> void {
  return;
}

fn returns_u8() -> u8 {
  return 1;
}

fn main() -> void {
  // narrowing: u16 into u8
  u16 wide = 300;
  u8 narrow = wide;

  // pointer/int mismatch
  u8 *ptr = 10;

  // wrong return type
  u8 bad = returns_u8();

  // using a void function's result as a value
  u8 from_void = takes_u8(1);
}

fn bad_return() -> u8 {
  u8 *ptr = &bad_return;
  return ptr;
}
