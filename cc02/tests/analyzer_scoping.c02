// Exercises scope behavior: shadowing, for-loop scoping, block scoping

fn main() -> void {
  u8 x = 1;

  // shadowing in an if block is allowed
  if (x > 0) {
    u8 x = 2;
    u8 y = x;
  }

  // x is still the outer u8 after the block
  u8 a = x;

  // for-loop variable stays scoped to the loop
  for (u8 i = 0; i < 10; i = i + 1) {
    u8 inner = i;
  }

  // i is not visible here - use a different name to prove no leak
  u8 i = 99;

  // nested for loops with same variable name
  for (u8 j = 0; j < 5; j = j + 1) {
    u8 tmp = j;
  }
  for (u8 j = 0; j < 5; j = j + 1) {
    u8 tmp = j;
  }

  // while body gets its own scope
  while (x > 0) {
    u8 w = x;
    x = x - 1;
  }

  // if/else blocks get their own scopes
  if (x == 0) {
    u8 b = 1;
  } else {
    u8 b = 2;
  }
}
