// Exercises function call errors: not a function, wrong arg count, wrong arg type

u8 not_a_fn;

fn takes_two(u8 a, u8 b) -> void {
  return;
}

fn main() -> void {
  // calling a variable as a function
  not_a_fn();

  // wrong number of arguments
  takes_two(1);
  takes_two(1, 2, 3);

  // wrong argument type: pointer where u8 expected
  u8 *ptr = null;
  takes_two(ptr, 1);
}
