`- TranslationUnitDecl
   `- FunctionDecl main() -> void
      `- IfStmt
         |- [cond]
         |  `- IntegerLiteral (1)
         |- [then body]
         |  `- WhileStmt
         |     |- [cond]
         |     |  `- IntegerLiteral (0)
         |     `- [body]
         |        `- ForStmt
         `- [else body]
            |- ForStmt
            |  |- [init]
            |  |  `- VarDecl x : u8
            |  |     `- IntegerLiteral (0)
            |  |- [cond]
            |  |  `- BinaryOperator <
            |  |     |- Identifier x
            |  |     `- IntegerLiteral (69)
            |  `- [step]
            |     `- UnaryOperator ++
            |        `- Identifier x
            `- IfStmt
               |- [cond]
               |  `- BinaryOperator ==
               |     |- BinaryOperator %
               |     |  |- Identifier x
               |     |  `- IntegerLiteral (3)
               |     `- IntegerLiteral (0)
               `- [then body]
                  |- AssignStmt x =
                  |  `- BinaryOperator %
                  |     |- Identifier x
                  |     `- IntegerLiteral (3)
                  `- UnaryOperator ++
                     `- Identifier x
