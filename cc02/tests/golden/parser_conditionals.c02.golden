                        |  |- [cond]
                        |  |  `- BinaryOperator <
                        |  |     |- Identifier x
                        |  |     `- IntegerLiteral (69)
                        |  |- [step]
                        |  |  `- UnaryOperator ++
                        |  |     `- Identifier x
                        |  `- [body]
                        |     `- CompoundStmt
                        |        `- AssignStmt x =
                        |           `- BinaryOperator %
                        |              |- Identifier x
                        |              `- IntegerLiteral (2)
                        |- IfStmt
                        |  |- [cond]
                        |  |  `- BinaryOperator ==
                        |  |     |- BinaryOperator %
                        |  |     |  |- Identifier x
                        |  |     |  `- IntegerLiteral (3)
                        |  |     `- IntegerLiteral (0)
                        |  |- [then body]
                        |  |  |- CompoundStmt
                        |  |  |  |- AssignStmt x =
                        |  |  |  |  `- BinaryOperator %
                        |  |  |  |     |- Identifier x
                        |  |  |  |     `- IntegerLiteral (3)
                        |  |  |  `- UnaryOperator ++
                        |  |  |     `- Identifier x
                        |  `- [else if body]
                        |     `- IfStmt
