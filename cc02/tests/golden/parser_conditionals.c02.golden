            |  |     |  `- IntegerLiteral (0)
            |  |     `- [body]
            |  |        `- CompoundStmt
            |  |           `- ForStmt
            |  |              `- [body]
            |  |                 `- CompoundStmt
            `- [else if body]
               `- IfStmt
                  |- [cond]
                  |  `- IntegerLiteral (0)
                  |- [then body]
                  |  |- CompoundStmt
                  |  |  `- VarDecl x : u8
                  |  |     `- BinaryOperator *
                  |  |        |- IntegerLiteral (10)
                  |  |        `- IntegerLiteral (42)
                  `- [else body]
                     `- CompoundStmt
                        |- ForStmt
                        |  |- [init]
