// parser_bitwise.c02
// Exercises &, |, ^, ~, <<, >> at every level: basic, precedence, chaining, mixed with logical ops.

fn main() -> void {
  // basic single ops
  u8 a = 5 & 3;
  u8 b = 5 | 2;
  u8 c = 5 ^ 1;
  u8 d = ~5;
  u8 e = 1 << 2;
  u8 f = 16 >> 2;

  // chained same-precedence ops (left-associativity check)
  u8 g = 1 | 2 | 4;
  u8 h = 1 & 2 & 4;
  u8 i = 1 ^ 2 ^ 4;
  u8 j = 1 << 1 << 1;
  u8 k = 16 >> 1 >> 1;

  // precedence: & higher than ^ higher than |
  u8 l = 1 | 2 & 3 ^ 4;

  // precedence: shift higher than comparison, lower than term
  u8 m = 1 << 2 + 1;
  u8 n = 1 + 2 << 1;
  u8 o = 1 << 2 < 8;

  // bitwise vs logical interplay
  u8 p = (1 & 1) && (2 | 0);
  u8 q = 1 == 1 & 1;

  // unary ~ chained and combined
  u8 r = ~~5;
  u8 s = ~(5 & 3);
  u8 t = ~5 | 2;

  // & disambiguation: address-of (unary, prefix) vs bitwise-and (infix)
  u8 x = 10;
  u8 y = x & 1;
  u8* z = &x;

  // mixed in conditionals
  if ((x & 1) == 0) {
    x = x | 1;
  } else if ((x >> 1) > 2) {
    x = x ^ 0xFF;
  } else {
    x = ~x;
  }

  // mixed in while/for
  while ((x & 0x0F) != 0) {
    x = x >> 1;
  }

  for (u8 i = 0; i < 8; i = i + 1) {
    x = x | (1 << i);
  }

  return;
}