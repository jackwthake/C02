// Global variable initializers are now type-checked in the global scope, just
// like local declarations - previously they were ignored entirely.

struct Thing { u8 a; }

u8 from_undeclared = nope;        // undeclared identifier in a global initializer
u16 *bad_ptr = 5;                 // pointer initialized from an integer
Thing t = 5;                      // struct global initialized from an int

fn main() -> void {}
