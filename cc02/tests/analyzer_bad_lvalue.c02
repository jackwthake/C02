// Gap C: assignment targets and the operands of & / ++ / -- must be lvalues
// (a named variable, a struct field, or a pointer dereference) - never a
// computed value.

fn main() -> void {
  u8 a = 1;
  u8 b = 2;

  a + b = 3;         // cannot assign to a computed value
  u8 *p = &(a + b);  // cannot take the address of a non-lvalue
  ++(a + b);         // cannot increment a non-lvalue
}
