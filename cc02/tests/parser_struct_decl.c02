// parser_struct_decl.c02
// Exercises struct decls, field access (single + chained), generalized
// assignment targets (identifier, field, deref), compound assignment on
// each target shape, and interaction with control flow / bitwise ops.

struct Point {
  u8 x;
  u8 y;
}

struct Engine {
  u16 rpm;
  u8 cylinders;
}

struct Car {
  Engine engine;
  Point position;
  u8* tag;
}

reg u8 PORTB @ 0x6002;

fn main() -> void {
  // --- basic struct decl + plain identifier assignment still works ---
  u8 a = 10;
  a = 20;
  a += 5;
  a -= 1;
  a *= 2;
  a /= 4;
  a %= 3;

  // --- single-level field access as rvalue ---
  Point p;
  u8 px = p.x;

  // --- single-level field access as assignment target ---
  p.x = 10;
  p.y = 20;

  // --- compound assignment on a field target ---
  p.x += 5;
  p.y -= 1;
  p.x *= 2;

  // --- chained field access (struct containing struct) ---
  Car c;
  c.engine.rpm = 4500;
  c.engine.cylinders = 6;
  c.position.x = 1;
  c.position.y = 2;

  // chained field access as rvalue
  u16 rpm = c.engine.rpm;

  // compound assign through a chain
  c.engine.rpm += 100;
  c.position.x += c.position.y;

  // --- field access mixed into expressions ---
  u8 sum = p.x + p.y;
  u8 cmp = p.x > p.y;
  u8 mixed = (p.x & 0x0F) | (p.y << 4);

  // --- field access as function call argument ---
  someFunc(p.x, c.engine.rpm);

  // --- deref assignment, now unified under NODE_ASSIGN ---
  u8* ptr = &a;
  *ptr = 99;
  *ptr += 1;

  // pointer-to-struct field through deref combined with field access
  Car* cptr = &c;
  // not dereferencing cptr itself here (no -> operator yet); accessing via
  // the pointed-to struct's own field path through c directly is fine,
  // this just exercises taking address of a struct
  u8 tagval = *c.tag;

  // --- field access inside control flow ---
  if (p.x > 0) {
    p.x -= 1;
  } else if (p.y > 0) {
    p.y -= 1;
  } else {
    p.x = 0;
    p.y = 0;
  }

  while (c.engine.rpm > 1000) {
    c.engine.rpm -= 100;
  }

  for (u8 i = 0; i < 10; i = i + 1) {
    c.position.x += 1;
  }

  // --- struct decl allowed inside a block too ---
  struct Local {
    u8 value;
  }

  Local l;
  l.value = 42;

  return;
}

fn someFunc(u8 v, u16 r) -> void {
  return;
}