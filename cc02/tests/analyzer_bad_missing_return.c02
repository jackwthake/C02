// A non-void function must not fall off its end without returning a value.
// This is a shallow check: a function ending in a control-flow statement is
// assumed to maybe-return (so if/else that returns is fine), but one that
// ends in a plain statement - or is empty - is flagged.

fn empty() -> u8 {
}

fn falls_through() -> u16 {
  u16 x = 1;         // ends in a declaration, not a return
}

fn main() -> void {}
