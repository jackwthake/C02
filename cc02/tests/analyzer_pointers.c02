// Exercises pointer operations: address-of, dereference, pointer assignment

fn main() -> void {
  u8 val = 42;
  u8 *ptr = &val;

  // deref read
  u8 copy = *ptr;

  // deref write
  *ptr = 99;

  // null assignment and comparison
  u8 *empty = null;
  if (empty == null) {
    empty = &val;
  }

  // string literal is u8*
  u8 *msg = "hello";

  // pointer to pointer
  u8 **dptr = &ptr;
}
