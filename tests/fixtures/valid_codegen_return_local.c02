reg u8 PORTB @ 0x6000;
reg u8 DDRB @ 0x6002;

fn ret_local() -> u8 {
  u8 x = 0x55;
  return x;
}

fn ret_local2() -> u16 {
  u16 x = 0x00FF;
  return x;
}

fn main() -> void {
  DDRB = 0xFF;
  
  u8 res = ret_local();
  PORTB = res;
  PORTB = 0x00;
  u16 res2 = ret_local2();
  PORTB = (u8)res2;
  PORTB = 0x00;
}