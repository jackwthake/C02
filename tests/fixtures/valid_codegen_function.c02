reg u8 PORTB @ 0x6000;
reg u8 DDRB @ 0x6002;

fn add_bytes(u8 a, u8 b) -> u8 {
  return a + b;
}

fn add_bytes_local(u8 a, u8 b) -> u8 {
  u8 result = a + b;
  return result;
}

fn main() -> void {
  DDRB = 0xFF; // LEDs clear so this happens

  u8 x = 100;
  u8 y = 70;

  u8 result = add_bytes(x, y); // should return 170 or 0xAA

  // PORTB just gets cleared no visible writes, either crashes or just writes 0x00 to portb for each of these
  PORTB = x + y; // should set PORTB to 170 if the stack is preserved correctly
  PORTB = result; // shouldnt change PORTB

  // im pretty sure this line causes a crash, no subsequent writes happen.
  PORTB = add_bytes_local(45, 40); // 0x55 same pattern shifted <-- PORTB doesnt change, fail

  PORTB = result; // ensure locals are still usable
  PORTB = x + y; // should set PORTB to 170 if the stack is preserved correctly
  PORTB = x; // should be 100
  PORTB = y; // should be 70
}
