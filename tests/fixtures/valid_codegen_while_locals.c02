reg u8 PORTB @ 0x6000;
reg u8 DDRB @ 0x6002;

fn main() -> void {
  DDRB = 0xFF;
  
  u8 delay = 0;
  u8 x = 0;
  
  PORTB = 0;
  
  while (1) { // ERR: whiles are causing stack corruption somehow
    delay = 1;
    while (delay != 255) {
      delay += 1;
    }

    x = x + 1;
    PORTB = x; // this write never happens
  }
}